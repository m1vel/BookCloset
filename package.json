{
  "name": "bookcloset",
  "productName": "BookCloset",
  "version": "1.1.0",
  "description": "BookCloset — красивая читалка книг любых форматов",
  "author": "BookCloset",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && node scripts/electron-vite.mjs dev",
    "start": "node scripts/electron-vite.mjs preview",
    "build": "node scripts/copy-assets.mjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "samples": "python scripts/make_samples.py",
    "test": "node tests/run.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.3",
    "hyphen": "^1.14.1",
    "jschardet": "^3.1.4",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rtf.js": "^3.0.9",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "7z-wasm": "^1.2.0",
    "word-extractor": "^1.0.4"
  }
}
